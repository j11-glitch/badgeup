rules_version = '2';

// Roles:
//   superuser  one account, created by hand in the console (never from the app);
//              everything an admin can do, plus adding and removing admins.
//   admin      adds and deletes children, edits their daily tasks, gives manual badges
//              and Founder diamonds.
//   visitor    no login; can see every child's badges and tick off today's tasks.
// Staff are stored in /staff/{email} (lower-case email as document id).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(signedInEmail());
    }

    // Google accounts have verified emails; requiring it stops unverified email sign-ups.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(staffPath());
    }

    function isSuperuser() {
      return isStaff() && get(staffPath()).data.role == 'superuser';
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Manual badge ids (MANUAL_BADGE_IDS in src/domain/catalog.ts).
    function manualBadgeIds() {
      return ['firstStep', 'gettingStarted', 'betaTester', 'helpful', 'teamPlayer', 'mentor',
              'collaborator', 'dedicated', 'earlyBird', 'explorer', 'creator',
              'patient', 'toothStar', 'outdoors', 'screenSmart'];
    }

    // Limits match LIMITS in src/domain/validation.ts.
    // Children made by the first version may still lack tasks, manual or diamonds.
    function isValidChild(data) {
      return isText(data.name, 1, 60)
        && data.get('tasks', []) is list && data.get('tasks', []).size() <= 12
        && data.get('manual', {}) is map && data.get('manual', {}).keys().hasOnly(manualBadgeIds())
        && data.get('diamonds', 0) is int && data.get('diamonds', 0) >= 0 && data.get('diamonds', 0) <= 999
        && data.updatedAt == request.time;
    }

    // A day id is "YYYY-MM-DD". Visitors may only save a date close to now (today, and
    // yesterday for a late evening), so old days cannot be filled in afterwards.
    function isNearNow(day) {
      let parts = day.split('-');
      let start = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return request.time > start - duration.value(1, 'd')
        && request.time < start + duration.value(2, 'd');
    }

    function isValidDay(day, data) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.keys().hasOnly(['required', 'done', 'updatedAt'])
        && data.required is list && data.required.size() >= 1 && data.required.size() <= 12
        && data.done is list && data.done.size() <= 12 && data.required.hasAll(data.done)
        && data.updatedAt == request.time;
    }

    // ---- Staff (admins and the superuser): private, managed by the superuser ----
    match /staff/{email} {
      allow read: if isStaff();
      // The superuser adds plain admins only; nobody can create another superuser here.
      allow create: if isSuperuser()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.addedBy == signedInEmail()
        && request.resource.data.addedAt == request.time;
      // Admins can be removed; the superuser document cannot.
      allow delete: if isSuperuser() && resource.data.role == 'admin';
      allow update: if false;
    }

    // ---- Children (they do not log in): public, managed by staff ----
    match /users/{userId} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['name', 'tasks', 'manual', 'diamonds', 'createdAt', 'updatedAt'])
        && isValidChild(request.resource.data)
        && request.resource.data.tasks == []
        && request.resource.data.manual == {}
        && request.resource.data.diamonds == 0
        && request.resource.data.createdAt == request.time;
      // "badgeIds" is left over from the first version on older documents.
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['name', 'tasks', 'manual', 'diamonds', 'badgeIds', 'createdAt', 'updatedAt'])
        && isValidChild(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isStaff();

      // Which tasks were done each day. Children tick them off themselves without logging in,
      // so anyone may save a day close to now; staff can fix any day and delete days.
      match /days/{day} {
        allow read: if true;
        allow create, update: if exists(/databases/$(database)/documents/users/$(userId))
          && isValidDay(day, request.resource.data)
          && (isStaff() || isNearNow(day));
        allow delete: if isStaff();
      }
    }

    // ---- Everything else stays locked ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
